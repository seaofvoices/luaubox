{
  "name": "luaubox",
  "type": "module",
  "version": "0.1.0",
  "description": "A tool for building Luau projects into Roblox models, bundles and more",
  "license": "MIT",
  "author": "jeparlefrancais <jeparlefrancais21@gmail.com>",
  "homepage": "https://github.com/seaofvoices/luaubox#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seaofvoices/luaubox.git"
  },
  "keywords": [
    "luau",
    "lua",
    "bundle",
    "roblox",
    "lune",
    "tool"
  ],
  "files": [
    "dist"
  ],
  "main": "dist/luaubox.luau",
  "bin": "bin/luaubox.js",
  "scripts": {
    "luaubox": "luaubox",
    "prepare": "npmluau && lune setup",
    "build": "darklua process --config darklua.lune.json main.luau dist/luaubox.luau",
    "lint": "luau-lsp analyze --platform=standard --base-luaurc=.luaurc --settings=.vscode/settings.json --ignore '**/node_modules/**' --ignore 'node_modules/**' src",
    "format": "stylua .",
    "style-check": "stylua . --check",
    "verify-pack": "yarn pack --dry-run",
    "clean": "rm -rf dist node_modules temp"
  },
  "devDependencies": {
    "luau-path": "^0.1.1",
    "npmluau": "^0.1.3"
  },
  "packageManager": "yarn@4.17.1"
}
